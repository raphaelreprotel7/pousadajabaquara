# Copie para .env e ajuste.

# Segredo que assina os tokens do Payload. Troque por algo aleatorio e longo.
PAYLOAD_SECRET=troque-este-valor-por-uma-string-aleatoria-longa

# SQLite local (padrao — nao exige nenhuma infra)
DATABASE_URI=file:./recanto-do-jabaquara.db

# URL publica do site. Usada pelo live preview, pelo SEO e pelo .well-known.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Producao (Vercel). Deixe em branco em desenvolvimento.
# ---------------------------------------------------------------------------

# Postgres. O adaptador e escolhido pela URL: comecando com "postgres", o
# projeto usa Postgres; caso contrario segue no arquivo SQLite local.
# Na Vercel a integracao de banco injeta POSTGRES_URL sozinha e o projeto a
# aceita — nao precisa duplicar a variavel no painel.
# Para rodar o seed a partir da sua maquina, use a conexao DIRETA (sem
# "-pooler" no host): o pool nao aceita a criacao de schema.
# DATABASE_URI=postgres://usuario:senha@host/banco?sslmode=require

# Turso — SQLite hospedado. Alternativa ao Postgres; nada no codigo muda.
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=

# Desliga o push automatico de schema. Ligue (false) quando o site estiver no ar:
# a partir dai mudanca de schema entra por script, nao por push.
# PAYLOAD_DB_PUSH=false

# Vercel Blob — armazena os uploads da collection Media.
# BLOB_READ_WRITE_TOKEN=

# GoHighLevel — encaminhamento das submissoes de formulario.
# GHL_API_TOKEN=
# GHL_LOCATION_ID=
